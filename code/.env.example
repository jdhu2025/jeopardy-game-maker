# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
# Quizboard AI provider (leave blank to use the local demo generator)
AI_API_URL="https://openrouter.ai/api/v1/chat/completions"
AI_API_KEY=""
AI_MODEL="qwen/qwen3.8-27b:free"
